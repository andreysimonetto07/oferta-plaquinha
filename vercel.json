{
 "$schema":"https://openapi.vercel.sh/vercel.json",
 "framework":null,"buildCommand":"npm run build","outputDirectory":"dist",
 "functions":{"api/**/*.js":{"maxDuration":30}},
 "headers":[{"source":"/(.*)","headers":[
  {"key":"X-Content-Type-Options","value":"nosniff"},
  {"key":"X-Frame-Options","value":"DENY"},
  {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
  {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"},
  {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'"}
 ]},{"source":"/api/(.*)","headers":[{"key":"Cache-Control","value":"no-store"}]}]
}
